// Key to the Orders of Arachnida
digraph {
	rankdir=TB
	title [label="Key to the Orders of Arachnida" fillcolor=lightgreen shape=box style=filled]
	1 [label="1: Opisthosoma (abdomen) unsegmented or, if segmented, with spinnerets posteriorly on ventral side (Figures 5-5 and 5-8, ALS,PLS,PMS)" fillcolor=lightblue shape=box style=filled]
	"1'" [label="1': Opisthosoma distinctly segmented, without spinnerets" fillcolor=lightblue shape=box style=filled]
	2 [label="2: Opisthosoma petiolate (Figures 5-5 and 5-9 through 5-13) Araneae
Order: Araneae" fillcolor=lightgreen shape=box style=filled]
	"2'" [label="2': Opisthosoma not petiolate, but broadly joined to prosoma (Figures 5-15 through 5-22) Acari
Order: Acari" fillcolor=lightgreen shape=box style=filled]
	3 [label="3: Opisthosoma with a tail-like prolongation that is either thick and terminating in a sting (Figure 5-3) or slender and more or less whiplike (Figure 5-4A,B); mostly tropical" fillcolor=lightblue shape=box style=filled]
	"3'" [label="3': Opisthosoma without a tail-like prolongation or with a very short leaflike appendage" fillcolor=lightblue shape=box style=filled]
	4 [label="4: Opisthosoma ending in a sting (Figure 5-3); first pair of legs not greatly elongated; second ventral segment of opisthosoma with a pair of comblike organs Scorpiones
Order: Scorpiones" fillcolor=lightgreen shape=box style=filled]
	"4'" [label="4': Opisthosoma not ending in a sting; first pair of legs longer than other pairs (Figure 5-4A,B); second ventral segment of opisthosoma without comblike organs" fillcolor=lightblue shape=box style=filled]
	5 [label="5: Pedipalps slender, similar to legs (Figure 5-4A); minute forms, 5 mm or less in length Palpigradi
Order: Palpigradi" fillcolor=lightgreen shape=box style=filled]
	"5'" [label="5': Pedipalps usually much stouter than any of the legs (Figure 5-4B); mostly larger forms" fillcolor=lightblue shape=box style=filled]
	6 [label="6: With two median eyes on a tubercle anteriorly and a group of three eyes on each lateral margin; tail long, filiform, and many-segmented; pedipalps nearly straight or curved mesad, extending forward, and moving laterally (Figure 5-4B); body blackish, more than 50 mm in length Uropygi
Order: Uropygi" fillcolor=lightgreen shape=box style=filled]
	"6'" [label="6': Eyes lacking; tail short, one- to four-segmented; pedipalps arching upward, forward, and downward and moving vertically; body yellowish or brownish, less than 8 mm in length Schizomida
Order: Schizomida" fillcolor=lightgreen shape=box style=filled]
	7 [label="7: Pedipalps chelate (pincerlike) (Figure 5-23); body more or less oval, flattened, usually less than 5 mm in length Pseudoscorpiones
Order: Pseudoscorpiones" fillcolor=lightgreen shape=box style=filled]
	"7'" [label="7': Pedipalps raptorial or leglike, but not chelate; body not particularly flattened; size variable" fillcolor=lightblue shape=box style=filled]
	8 [label="8: Chelicerae very large, usually about as long as prosoma, and extending forward, and body slightly narrowed in middle (Figure 5-4C); color pale yellow to brownish; length 20 to 30 mm; mostly nocturnal desert forms occurring in western United States Solifugae
Order: Solifugae" fillcolor=lightgreen shape=box style=filled]
	"8'" [label="8': Without the preceding combination of characters" fillcolor=lightblue shape=box style=filled]
	9 [label="9: First pair of legs very long, with long tarsi; opisthosoma constricted at base; mainly tropical" fillcolor=lightblue shape=box style=filled]
	"9'" [label="9': First legs similar to the others and (except in the Opiliones) not usually long; opisthosoma not particularly constricted at base" fillcolor=lightblue shape=box style=filled]
	10 [label="10: Prosoma longer than wide, lateral margins nearly parallel, and with a transverse membranous suture in caudal third; opisthosoma with a very short terminal appendage; length 5-8 mm (see also couplet 6') Schizomida
Order: Schizomida" fillcolor=lightgreen shape=box style=filled]
	"10'" [label="10': Prosoma wider than long, lateral margins rounded or arched, and without a transverse suture; opisthosoma without a terminal appendage; length variable, up to about 50 mm Amblypygi
Order: Amblypygi" fillcolor=lightgreen shape=box style=filled]
	11 [label="11: Orange-red to brown arachnids, about 3 mm in length, with broad flap at anterior end of prosoma concealing chelicerae; legs not unusually long, animal somewhat mitelike or ticklike in appearance; recorded from Rio Grande Valley of Texas Ricinulei
Order: Ricinulei" fillcolor=lightgreen shape=box style=filled]
	"11'" [label="11': Size and color variable, but without broad flap at anterior end of prosoma covering chelicerae; legs variable in length, often very long and slender (Figure 5-14); widely distributed Opiliones
Order: Opiliones" fillcolor=lightgreen shape=box style=filled]
	1 -> 2 [label=Yes color=darkgreen]
	1 -> "1'" [label=No color=darkred]
	"1'" -> 3 [label=Yes color=darkgreen]
	2 -> "2'" [label=No color=darkred]
	3 -> 4 [label=Yes color=darkgreen]
	3 -> "3'" [label=No color=darkred]
	"3'" -> 7 [label=Yes color=darkgreen]
	4 -> "4'" [label=No color=darkred]
	"4'" -> 5 [label=Yes color=darkgreen]
	5 -> "5'" [label=No color=darkred]
	"5'" -> 6 [label=Yes color=darkgreen]
	6 -> "6'" [label=No color=darkred]
	7 -> "7'" [label=No color=darkred]
	"7'" -> 8 [label=Yes color=darkgreen]
	8 -> "8'" [label=No color=darkred]
	"8'" -> 9 [label=Yes color=darkgreen]
	9 -> 10 [label=Yes color=darkgreen]
	9 -> "9'" [label=No color=darkred]
	"9'" -> 11 [label=Yes color=darkgreen]
	10 -> "10'" [label=No color=darkred]
	11 -> "11'" [label=No color=darkred]
	title -> 1 [style=dashed]
}
